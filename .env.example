# OpenRouter — create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Fast model for concurrent panelists + interrupt votes.
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
OPENROUTER_MODEL_STRONG=deepseek/deepseek-v4-pro

# Voice (Kokoro is widely available; Qwen TTS cannot take speed != 1)
OPENROUTER_TTS_MODEL=hexgrad/kokoro-82m
OPENROUTER_STT_MODEL=mistralai/voxtral-mini-3b-2507

HOST=127.0.0.1
PORT=8787
APP_URL=http://127.0.0.1:8787
